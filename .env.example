# Public URL of this app (no trailing slash)
NEXT_PUBLIC_APP_URL=https://letschat.example.co.uk

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (console.anthropic.com > API keys). Use a NEW key, not the Dleading website's key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Stripe (Developers > API keys, and the two monthly prices you create)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
# Optional free trial length in days (0 = no trial)
TRIAL_DAYS=0

# Optional: email new leads to businesses (resend.com). Leads are always saved in the dashboard.
RESEND_API_KEY=
LEAD_EMAIL_FROM=LetsChat <leads@yourdomain.co.uk>

# Comma-separated emails that can open /admin
ADMIN_EMAILS=

# Optional: a bot id to show as the live demo on the homepage
NEXT_PUBLIC_DEMO_BOT_ID=
